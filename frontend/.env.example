# Copy this file to an environment-specific .env file for local use.
VITE_APP_TITLE=Agri Digital Platform
VITE_APP_LOGO_TITLE=Agri Digital Platform
VITE_APP_ENV=development
VITE_APP_BASE_API=/prod-api
VITE_APP_PROXY_TARGET=http://127.0.0.1:31100
VITE_APP_PROXY_REWRITE=false
VITE_APP_CONTEXT_PATH=/
VITE_APP_PORT=5173
VITE_APP_ENCRYPT=false
VITE_APP_CLIENT_ID=tenant-client
VITE_APP_WEBSOCKET=false
